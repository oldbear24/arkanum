# Copy to .env (never commit real values). The binary reads plain environment
# variables; Docker Compose, `docker run --env-file .env`, `make dev`, `make seed`
# or your process manager passes them in.

# Docker Compose only: the image tag, and the port on the host (or 127.0.0.1:8090).
ARKANUM_VERSION=latest
ARKANUM_PORT=8090

# 32 characters. Encrypts PocketBase settings (SMTP password, OAuth2 secrets) at rest.
PB_ENCRYPTION_KEY=

# Public URL of the app. Used in e-mail links.
APP_URL=http://localhost:8090

# E-mail (verification, password reset). Leave SMTP_HOST empty to keep it disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SENDER_ADDRESS=noreply@example.com
SMTP_SENDER_NAME=Arkánum

# Optional OAuth2 sign-in. A provider is enabled only when both of its values are set.
# Setting up Discord is described in the README, section "Přihlášení přes Discord".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Password for the demo accounts created by `arkanum seed`.
# Without it, `arkanum seed` generates a random one and prints it. `make seed` uses arkanum-dev.
SEED_PASSWORD=
